<plugin xmlns="http://apache.org/cordova/ns/plugins/1.0"
        xmlns:android="http://schemas.android.com/apk/res/android"
        id="cordova-plugin-appsflyer-sdk"
        version="7.0.2">
    <name>AppsFlyer</name>
    <description>Cordova Plugin AppsFlyer</description>
    <license>Apache 2.0</license>
    <keywords>cordova,appsflyer</keywords>
    <repo>https://github.com/AppsFlyerSDK/appsflyer-cordova-plugin.git</repo>
    <engines>
        <engine name="cordova" version=">=4.3.0"/>
    </engines>

    <js-module src="www/appsflyer.js" name="appsflyer">
        <clobbers target="window.plugins.appsFlyer"/>
    </js-module>


    <!-- android -->
    <platform name="android">
        <!-- cordova-android only applies the kotlin-android Gradle plugin (and wires up the
             src/main/kotlin source set / kotlinc task) when this preference is set; it is NOT
             auto-detected from the presence of .kt source files. Without it, AppsFlyerPlugin.kt
             is silently skipped by the build (no Gradle error), so `cordova.exec` calls into it
             hang forever waiting on a native handler that was never registered. -->
        <config-file target="config.xml" parent="/*">
            <preference name="GradlePluginKotlinEnabled" value="true"/>
        </config-file>
        <config-file target="res/xml/config.xml" parent="/*">
            <feature name="AppsFlyerPlugin">
                <param name="android-package" value="com.appsflyer.cordova.plugin.AppsFlyerPlugin"/>
            </feature>
        </config-file>
        <config-file target="AndroidManifest.xml" parent="/*">
            <uses-permission android:name="android.permission.INTERNET"/>
            <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
            <uses-permission android:name="com.google.android.gms.permission.AD_ID" />
        </config-file>
        <config-file target="AndroidManifest.xml" parent="/*/application">
            <receiver android:name="com.appsflyer.MultipleInstallBroadcastReceiver" android:exported="true">
                <intent-filter>
                    <action android:name="com.android.vending.INSTALL_REFERRER"/>
                </intent-filter>
            </receiver>
        </config-file>

        <!-- cordova-android's source-file installer only special-cases the ".java" extension
             (pluginHandlers.js getInstallDestination); a ".kt" target-dir without the "app/"
             prefix falls through to app/src/main/<target-dir>, landing outside both the default
             Java source set and the src/main/kotlin dir cordovaAF's build.gradle registers. That
             leaves the class uncompiled silently (Gradle doesn't error on an unreferenced source
             dir), so `cordova.exec` calls into AppsFlyerPlugin hang forever: Cordova's
             PluginManager fails ClassNotFoundException and never calls back. Target the app/
             directory explicitly so the installer copies it verbatim into the real Kotlin
             source set. -->
        <source-file src="src/android/com/appsflyer/cordova/plugin/AppsFlyerPlugin.kt"
                     target-dir="app/src/main/kotlin/com/appsflyer/cordova/plugin"/>
        <framework src="src/android/cordovaAF.gradle" custom="true" type="gradleReference"/>
    </platform>


    <!-- ios -->
    <platform name="ios">
        <config-file target="config.xml" parent="/*">
            <feature name="AppsFlyerPlugin">
                <param name="ios-package" value="AppsFlyerPlugin"/>
            </feature>
        </config-file>
        <!-- This plugin ships Swift source; cordova-ios doesn't set SWIFT_VERSION on a project
             that had none of its own, and Xcode then refuses to build at all. -->
        <hook type="after_prepare" src="hooks/af_set_swift_version.js"/>
        <header-file src="src/ios/AppsFlyerX+AppController.h"/>
        <source-file src="src/ios/AppsFlyerX+AppController.m"/>
        <source-file src="src/ios/AppsFlyerPlugin.swift"/>
        <source-file src="src/ios/AppsFlyerAttribution.swift"/>
        <podspec>
            <config>
            </config>
            <pods use-frameworks="true">
               <pod name="AppsFlyerRPC" spec="7.0.13"/>
            </pods>
        </podspec>
    </platform>

</plugin>
